# ============================================================
# Revyn – Environment Variables Configuration
# Razorpay AI Buildathon 2026 | Track 03 – AI Revenue Recovery
# ============================================================

# 1. Supabase (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. Razorpay API Credentials (TEST MODE ONLY – Must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. Groq AI API Key (Used strictly for ambiguous failure diagnosis)
GROQ_API_KEY=gsk_your_groq_api_key

# 4. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
